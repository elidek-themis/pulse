{{ bos_token }}
{%- set has_system = messages and messages[0]['role'] == 'system' -%}
{%- set start_idx = 1 if has_system else 0 -%}
{%- for i in range(start_idx, messages|length) -%}
    {%- set message = messages[i] -%}
    {%- if (message['role'] == 'user') != ((i - start_idx) % 2 == 0) -%}
        {{ raise_exception('Conversation roles must alternate user/assistant/user/assistant/...') }}
    {%- endif -%}
    {%- if message['role'] == 'assistant' -%}
        {%- set role = 'model' -%}
    {%- else -%}
        {%- set role = 'user' -%}
    {%- endif -%}
    {%- if has_system and i == start_idx and message['role'] == 'user' -%}
        {%- set combined = (messages[0]['content'] | trim) ~ '\n\n' ~ (message['content'] | trim) -%}
    {%- else -%}
        {%- set combined = message['content'] | trim -%}
    {%- endif -%}
<start_of_turn>{{ role }}
{{ combined }}<end_of_turn>
{% endfor %}
{%- if add_generation_prompt -%}
<start_of_turn>model
{%- endif -%}
